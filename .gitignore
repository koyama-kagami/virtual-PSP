# Only publish the application, not local research, downloads or generated assets.
/*
!/.gitignore
!/README.md
!/THIRD_PARTY.md
!/docs/
!/work/
/docs/*
!/docs/screenshots/
!/docs/architecture.md
!/docs/psp-runtime-quickstart.md
/work/*
!/work/psp-studio/
!/work/psp-runtime/
/work/psp-runtime/*
!/work/psp-runtime/*.py
!/work/psp-runtime/*.ps1
!/work/psp-runtime/requirements.txt
!/work/psp-runtime/runtime-manifest.json
!/work/psp-runtime/INPUT_VALIDATION.md
**/node_modules/
**/.venv/
**/__pycache__/
**/.cache/
**/*.pyc
**/*.log
**/.env
**/.env.*
**/*-state.json
**/*-receipt.json
/work/psp-studio/benchmarks/*-results.json
